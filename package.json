{
  "name": "local-listen",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "install-assets": "tsx scripts/install-assets.ts",
    "pack": "pnpm run build && mkdir -p releases && zip -r releases/local-listen-v$npm_package_version.zip dist/",
    "preview": "vite preview",
    "check": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "onnxruntime-web": "1.27.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@crxjs/vite-plugin": "^2.7.1",
    "@types/chrome": "^0.2.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
